{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperfilelens.local/schemas/storage-provider-catalog-v1.json",
  "title": "HyperFileLens Object Storage Provider Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "providers"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "$defs": {
    "nonEmptyDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*[A-Za-z])\\S(?:.*\\S)?$"
    },
    "endpointHostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "enabled", "regions"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-z][a-z0-9_-]{0,49}$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyDisplayName"
        },
        "enabled": {
          "type": "boolean"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          }
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "region_group",
        "region_group_en",
        "external_endpoint",
        "internal_endpoint",
        "driver",
        "s3_url_style",
        "use_tls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "display_name": {
          "$ref": "#/$defs/nonEmptyDisplayName"
        },
        "region_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]{0,99}$"
        },
        "region_group_en": {
          "$ref": "#/$defs/nonEmptyDisplayName"
        },
        "external_endpoint": {
          "$ref": "#/$defs/endpointHostname"
        },
        "internal_endpoint": {
          "$ref": "#/$defs/endpointHostname"
        },
        "driver": {
          "const": "s3"
        },
        "s3_url_style": {
          "enum": ["virtual_hosted", "path"]
        },
        "use_tls": {
          "const": true
        }
      }
    }
  }
}
